DATABASE_URL="mysql://root:root@localhost:3306/iplat"
REDIS_URL="redis://localhost:6379"
JWT_ACCESS_SECRET=请替换为随机64位字符串
JWT_ACCESS_EXPIRES=2h
JWT_REFRESH_SECRET=请替换为随机64位字符串
JWT_REFRESH_EXPIRES=7d
PORT=3000
UPLOAD_DIR=./uploads
CORS_ORIGINS=http://localhost:5173
# 站点数配额默认上限（P4E D51，默认 1；admin 可按用户调，见 site_quota）
SITE_DEFAULT_LIMIT=1
# 回收站自动清理：保留天数（P4F D58，默认 30）+ 总开关（默认开，false/0 关闭）
CLOUD_RECYCLE_RETENTION_DAYS=30
CLOUD_RECYCLE_CLEAN_ENABLED=true
