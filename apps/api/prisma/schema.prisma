// iplat 数据库模型（第一期 system 域，表名全部 sys_ 前缀）
// 约定：model PascalCase + @@map，字段 camelCase + @map snake_case
// 说明：使用 relationMode="prisma"（逻辑外键），不生成物理外键约束——
//   sys_menu/sys_dept 自关联以 parent_id=0 表示根，物理 FK 无法满足；
//   软删除场景下物理 FK 会阻碍删除。关联完整性由 Service 层保证。
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "mysql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

// ========== 用户与权限 ==========

/// 用户
model SysUser {
  id          BigInt    @id @default(autoincrement())
  username    String    @unique @map("username") @db.VarChar(50)
  password    String    @map("password") @db.VarChar(100)
  nickname    String    @map("nickname") @db.VarChar(50)
  email       String?   @map("email") @db.VarChar(100)
  phone       String?   @map("phone") @db.VarChar(20)
  avatar      String?   @map("avatar") @db.VarChar(255)
  /// 0 未知 1 男 2 女
  gender      Int       @default(0) @map("gender") @db.TinyInt
  deptId      BigInt?   @map("dept_id")
  /// 1 启用 0 禁用
  status      Int       @default(1) @map("status") @db.TinyInt
  remark      String?   @map("remark") @db.VarChar(255)
  lastLoginAt DateTime? @map("last_login_at")
  lastLoginIp String?   @map("last_login_ip") @db.VarChar(50)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  dept      SysDept?      @relation(fields: [deptId], references: [id])
  userRoles SysUserRole[]
  usageLogs AiUsageLog[]
  toolCalls AiToolCall[]

  @@index([deptId])
  @@map("sys_user")
}

/// 角色
model SysRole {
  id        BigInt    @id @default(autoincrement())
  name      String    @map("name") @db.VarChar(50)
  /// 角色标识，如 admin、common
  code      String    @unique @map("code") @db.VarChar(50)
  sort      Int       @default(0) @map("sort")
  status    Int       @default(1) @map("status") @db.TinyInt
  remark    String?   @map("remark") @db.VarChar(255)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  userRoles SysUserRole[]
  roleMenus SysRoleMenu[]

  @@map("sys_role")
}

/// 用户-角色
model SysUserRole {
  id     BigInt @id @default(autoincrement())
  userId BigInt @map("user_id")
  roleId BigInt @map("role_id")

  user SysUser @relation(fields: [userId], references: [id])
  role SysRole @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId])
  @@index([roleId])
  @@map("sys_user_role")
}

/// 菜单（目录/菜单/按钮三级）
model SysMenu {
  id        BigInt   @id @default(autoincrement())
  /// 0 为根
  parentId  BigInt   @default(0) @map("parent_id")
  name      String   @map("name") @db.VarChar(50)
  /// 1 目录 2 菜单 3 按钮
  type      Int      @map("type") @db.TinyInt
  /// 路由地址（type 1/2）
  path      String?  @map("path") @db.VarChar(200)
  /// 前端组件路径，如 system/user/index（type 2）
  component String?  @map("component") @db.VarChar(200)
  /// 权限标识，如 system:user:create（type 3 必填）
  perms     String?  @map("perms") @db.VarChar(100)
  icon      String?  @map("icon") @db.VarChar(50)
  sort      Int      @default(0) @map("sort")
  /// 1 显示 0 隐藏
  visible   Int      @default(1) @map("visible") @db.TinyInt
  /// 1 启用 0 禁用
  status    Int      @default(1) @map("status") @db.TinyInt
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  roleMenus SysRoleMenu[]

  @@index([parentId])
  @@map("sys_menu")
}

/// 角色-菜单
model SysRoleMenu {
  id     BigInt @id @default(autoincrement())
  roleId BigInt @map("role_id")
  menuId BigInt @map("menu_id")

  role SysRole @relation(fields: [roleId], references: [id])
  menu SysMenu @relation(fields: [menuId], references: [id])

  @@unique([roleId, menuId])
  @@index([menuId])
  @@map("sys_role_menu")
}

// ========== 组织与字典 ==========

/// 部门
model SysDept {
  id        BigInt    @id @default(autoincrement())
  /// 0 为根
  parentId  BigInt    @default(0) @map("parent_id")
  name      String    @map("name") @db.VarChar(50)
  sort      Int       @default(0) @map("sort")
  status    Int       @default(1) @map("status") @db.TinyInt
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  users SysUser[]

  @@index([parentId])
  @@map("sys_dept")
}

/// 字典类型
model SysDictType {
  id        BigInt   @id @default(autoincrement())
  name      String   @map("name") @db.VarChar(50)
  /// 类型标识，如 sys_common_status
  type      String   @unique @map("type") @db.VarChar(100)
  status    Int      @default(1) @map("status") @db.TinyInt
  remark    String?  @map("remark") @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  dataList SysDictData[]

  @@map("sys_dict_type")
}

/// 字典数据
model SysDictData {
  id        BigInt   @id @default(autoincrement())
  typeId    BigInt   @map("type_id")
  label     String   @map("label") @db.VarChar(50)
  value     String   @map("value") @db.VarChar(50)
  sort      Int      @default(0) @map("sort")
  status    Int      @default(1) @map("status") @db.TinyInt
  remark    String?  @map("remark") @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  dictType SysDictType @relation(fields: [typeId], references: [id])

  @@index([typeId])
  @@map("sys_dict_data")
}

// ========== 日志与文件 ==========

/// 登录日志
model SysLoginLog {
  id        BigInt   @id @default(autoincrement())
  username  String   @map("username") @db.VarChar(50)
  ip        String?  @map("ip") @db.VarChar(50)
  browser   String?  @map("browser") @db.VarChar(100)
  os        String?  @map("os") @db.VarChar(100)
  /// 1 成功 0 失败
  status    Int      @map("status") @db.TinyInt
  message   String?  @map("message") @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([username])
  @@map("sys_login_log")
}

/// 操作日志
model SysOperationLog {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt?  @map("user_id")
  username  String?  @map("username") @db.VarChar(50)
  module    String?  @map("module") @db.VarChar(50)
  action    String?  @map("action") @db.VarChar(50)
  method    String?  @map("method") @db.VarChar(10)
  url       String?  @map("url") @db.VarChar(255)
  params    String?  @map("params") @db.Text
  ip        String?  @map("ip") @db.VarChar(50)
  status    Int?     @map("status") @db.TinyInt
  errorMsg  String?  @map("error_msg") @db.Text
  /// 耗时（毫秒）
  duration  Int?     @map("duration")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("sys_operation_log")
}

/// 文件记录
model SysFile {
  id           BigInt   @id @default(autoincrement())
  originalName String   @map("original_name") @db.VarChar(255)
  storageName  String   @map("storage_name") @db.VarChar(255)
  path         String   @map("path") @db.VarChar(255)
  url          String   @map("url") @db.VarChar(255)
  size         BigInt   @map("size")
  mimeType     String?  @map("mime_type") @db.VarChar(100)
  uploaderId   BigInt?  @map("uploader_id")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("sys_file")
}

// ========== AI 域（P2a） ==========

/// 大模型厂商
model AiProvider {
  id        BigInt   @id @default(autoincrement())
  name      String   @map("name") @db.VarChar(50)
  /// 厂商标识：deepseek / kimi / qwen / zhipu
  code      String   @unique @map("code") @db.VarChar(30)
  /// OpenAI 兼容端点
  baseUrl   String   @map("base_url") @db.VarChar(200)
  /// 接口返回一律掩码
  apiKey    String?  @map("api_key") @db.VarChar(255)
  /// 1 启用 0 禁用
  status    Int      @default(1) @map("status") @db.TinyInt
  sort      Int      @default(0) @map("sort")
  remark    String?  @map("remark") @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  models AiModel[]

  @@map("ai_provider")
}

/// 模型
model AiModel {
  id          BigInt   @id @default(autoincrement())
  providerId  BigInt   @map("provider_id")
  displayName String   @map("display_name") @db.VarChar(50)
  /// API 模型名，如 deepseek-chat
  model       String   @map("model") @db.VarChar(100)
  /// 输入单价（积分/千 tokens）
  inputPrice  Decimal  @map("input_price") @db.Decimal(8, 4)
  /// 输出单价（积分/千 tokens）
  outputPrice Decimal  @map("output_price") @db.Decimal(8, 4)
  /// 上下文长度（tokens），用于消息截取
  maxContext  Int      @map("max_context")
  /// 是否支持工具调用（P2b 用，本期存值）
  supportTool Int      @default(0) @map("support_tool") @db.TinyInt
  /// 1 启用 0 禁用
  status      Int      @default(1) @map("status") @db.TinyInt
  sort        Int      @default(0) @map("sort")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  provider AiProvider @relation(fields: [providerId], references: [id])

  conversations AiConversation[]
  messages      AiMessage[]
  usageLogs     AiUsageLog[]

  @@unique([providerId, model])
  @@index([providerId])
  @@map("ai_model")
}

/// 会话
model AiConversation {
  id        BigInt    @id @default(autoincrement())
  userId    BigInt    @map("user_id")
  /// 首条消息前 20 字自动生成，可改
  title     String    @map("title") @db.VarChar(100)
  /// 当前选用模型（切换模型即更新此字段）
  modelId   BigInt?   @map("model_id")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  messages AiMessage[]
  model    AiModel?    @relation(fields: [modelId], references: [id])
  usageLogs AiUsageLog[]
  toolCalls AiToolCall[]

  @@index([userId, updatedAt])
  @@index([modelId])
  @@map("ai_conversation")
}

/// 消息
model AiMessage {
  id             BigInt    @id @default(autoincrement())
  conversationId BigInt    @map("conversation_id")
  /// user / assistant（system 不持久化，由后端拼装）
  role           String    @map("role") @db.VarChar(20)
  content        String    @map("content") @db.LongText
  /// DeepSeek 思考模式的 reasoning_content（多轮工具调用回喂需原样回传）
  reasoningContent String? @map("reasoning_content") @db.LongText
  /// P10 D82：附件元信息 [{fileId,name,ext,size,chars,mode,path}]，mode=inject|listed；**只存元信息不存内容**
  attachments    Json?     @map("attachments")
  /// assistant 消息记录所用模型，可空
  modelId        BigInt?   @map("model_id")
  /// assistant 消息记录实际用量
  tokensInput    Int?      @map("tokens_input")
  tokensOutput   Int?      @map("tokens_output")
  /// 本条消息扣减积分（user 消息为 0）
  credits       Int       @default(0) @map("credits")
  /// 1 正常 2 失败（流中断/上游错误）
  status        Int       @default(1) @map("status") @db.TinyInt
  createdAt     DateTime  @default(now()) @map("created_at")
  deletedAt     DateTime? @map("deleted_at")

  conversation AiConversation @relation(fields: [conversationId], references: [id])
  model        AiModel?       @relation(fields: [modelId], references: [id])
  toolCalls    AiToolCall[]

  @@index([conversationId, createdAt])
  @@index([modelId])
  @@map("ai_message")
}

/// 套餐
model AiPlan {
  id             BigInt    @id @default(autoincrement())
  name           String    @map("name") @db.VarChar(50)
  code           String    @unique @map("code") @db.VarChar(50)
  /// 每月积分额度
  monthlyCredits BigInt    @map("monthly_credits")
  /// 展示用（本期无真实支付）
  price          Decimal   @map("price") @db.Decimal(10, 2)
  description    String?   @map("description") @db.VarChar(500)
  /// 1 启用 0 禁用
  status         Int       @default(1) @map("status") @db.TinyInt
  sort           Int       @default(0) @map("sort")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  userPlans AiUserPlan[]

  @@map("ai_plan")
}

/// 用户订阅（每用户一行生效记录）
model AiUserPlan {
  id           BigInt   @id @default(autoincrement())
  userId       BigInt   @unique @map("user_id")
  planId       BigInt   @map("plan_id")
  /// 当前计费周期（开通日起一个自然月）
  cycleStart   DateTime @map("cycle_start")
  cycleEnd     DateTime @map("cycle_end")
  /// 本周期总额度（快照，换套餐即更新）
  totalCredits BigInt   @map("total_credits")
  /// 本周期已用
  usedCredits  BigInt   @default(0) @map("used_credits")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  plan AiPlan @relation(fields: [planId], references: [id])

  @@index([planId])
  @@map("ai_user_plan")
}

/// 用量明细
model AiUsageLog {
  id             BigInt   @id @default(autoincrement())
  userId         BigInt   @map("user_id")
  conversationId BigInt   @map("conversation_id")
  /// message_id 用于结算幂等（unique）
  messageId      BigInt   @unique @map("message_id")
  modelId        BigInt   @map("model_id")
  tokensInput    Int      @map("tokens_input")
  tokensOutput   Int      @map("tokens_output")
  /// 1 = usage 为字符数估算（上游未返回），0 = 上游真实值
  estimated      Int      @default(0) @map("estimated") @db.TinyInt
  credits        Int      @map("credits")
  createdAt      DateTime @default(now()) @map("created_at")

  conversation AiConversation @relation(fields: [conversationId], references: [id])
  model        AiModel        @relation(fields: [modelId], references: [id])
  user         SysUser        @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([conversationId])
  @@index([modelId])
  @@map("ai_usage_log")
}

/// 工具调用留痕（P2b）
model AiToolCall {
  id             BigInt    @id @default(autoincrement())
  conversationId BigInt    @map("conversation_id")
  messageId      BigInt    @map("message_id")
  userId         BigInt    @map("user_id")
  toolName       String    @map("tool_name") @db.VarChar(50)
  /// 模型生成的调用参数
  params         Json      @map("params")
  /// read / write
  risk           String    @map("risk") @db.VarChar(10)
  /// pending / confirmed / rejected / executed / failed
  status         String    @map("status") @db.VarChar(20)
  /// 执行结果摘要（截断存储，最多 2000 字符）
  result         String?   @map("result") @db.Text
  errorMsg       String?   @map("error_msg") @db.VarChar(500)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  conversation AiConversation @relation(fields: [conversationId], references: [id])
  message      AiMessage      @relation(fields: [messageId], references: [id])
  user         SysUser        @relation(fields: [userId], references: [id])

  @@index([conversationId])
  @@index([userId, createdAt])
  @@map("ai_tool_call")
}

// ========== 云盘域（P3） ==========

/// 文件树（文件+文件夹统一建模）
model CloudFile {
  id          BigInt    @id @default(autoincrement())
  /// 属主（逻辑关联 sys_user，禁 JOIN）
  userId      BigInt    @map("user_id")
  /// 0 = 根目录
  parentId    BigInt    @default(0) @map("parent_id")
  /// 文件/文件夹名（不含路径）
  name        String    @map("name") @db.VarChar(64)
  /// 1 文件夹 / 0 文件
  isDir       Int       @map("is_dir") @db.TinyInt
  /// 字节；文件夹恒 0
  size        BigInt    @default(0) @map("size")
  mime        String?   @map("mime") @db.VarChar(100)
  /// 小写不带点，预览白名单判断用
  ext         String?   @map("ext") @db.VarChar(20)
  /// StorageService 相对路径（yyyyMM/uuid.ext）；文件夹为 null
  storageName String?   @map("storage_name") @db.VarChar(120)
  /// 0 未审核 / 1 通过 / 2 驳回 / 3 审核中（D13 预留）
  auditStatus Int       @default(0) @map("audit_status") @db.TinyInt
  /// 公开标记三态：0=继承父目录（新建默认）/ 1=显式公开 / 2=显式阻断（R2 修订：上溯遇第一个非继承节点定生死）
  isPublic    Int       @default(0) @map("is_public") @db.TinyInt
  /// 公开链接 token（P4c D30：挂 fileId，改名/移动不变；仅显式公开行有值，取消公开置空=轮换）
  publicToken String?   @map("public_token") @db.VarChar(32) @unique
  /// 公开文件夹允许访客浏览列表：1=允许 / 0=仅知道完整路径可访问（P4c D32，仅文件夹有意义）
  allowListing Int      @default(1) @map("allow_listing") @db.TinyInt
  /// 非空 = 在回收站（R2 只标记自身）
  deletedAt   DateTime? @map("deleted_at")
  createTime  DateTime  @default(now()) @map("create_time")
  updateTime  DateTime  @updatedAt @map("update_time")

  shares CloudShare[]

  @@index([userId, parentId, deletedAt])
  @@index([userId, deletedAt])
  @@map("cloud_file")
}

/// 公开链接
model CloudShare {
  id         BigInt    @id @default(autoincrement())
  /// 创建者
  userId     BigInt    @map("user_id")
  /// 逻辑关联 cloud_file（P4d D48 起可为文件夹行，is_dir=1）
  fileId     BigInt    @map("file_id")
  /// 随机 URL-safe 串（crypto.randomBytes）
  token        String  @unique @map("token") @db.VarChar(32)
  /// 提取码哈希（P4d D47/R42：bcrypt，供访客校验）；NULL = 无密码
  passwordHash String? @map("password_hash") @db.VarChar(64)
  /// 提取码可逆密文（AES-256-GCM，仅供创建者本人回显；bcrypt 不可逆，故另存一份）
  passwordEnc  String? @map("password_enc") @db.VarChar(255)
  /// 下载成功 +1
  visitCount Int       @default(0) @map("visit_count")
  /// null = 永久
  expireAt   DateTime? @map("expire_at")
  /// 1 有效 / 0 已停止（过期不置状态，靠 expire_at 判定）
  status     Int       @default(1) @map("status") @db.TinyInt
  createTime DateTime  @default(now()) @map("create_time")

  file CloudFile @relation(fields: [fileId], references: [id])

  @@index([fileId])
  @@index([userId])
  @@map("cloud_share")
}

/// 配额
model CloudUsage {
  /// 懒创建（首次上传/查询配额时）
  userId     BigInt   @id @map("user_id")
  /// 字节，默认 CLOUD_DEFAULT_QUOTA（1GB）
  quota      BigInt   @map("quota")
  /// 字节（R3 记账规则）
  used       BigInt   @default(0) @map("used")
  updateTime DateTime @updatedAt @map("update_time")

  @@map("cloud_usage")
}

// ========== 个人网站域（P4a，表名 site_ 前缀） ==========

/// 站点（P4E D51 起每用户可多站，站点数上限由 site_quota 控制）
model SiteSite {
  id           BigInt   @id @default(autoincrement())
  /// 属主（逻辑关联 sys_user，禁 JOIN）；多站（配额由 site_quota 控制）
  userId       BigInt   @map("user_id")
  /// 站点标识（R11：格式 + 保留字黑名单 + 全局唯一）
  slug         String   @unique @map("slug") @db.VarChar(32)
  /// 站点标题
  title        String   @map("title") @db.VarChar(50)
  description  String?  @map("description") @db.VarChar(200)
  /// 站点根目录（逻辑关联 cloud_file，经 CloudFacade 校验）
  rootFolderId BigInt   @map("root_folder_id")
  /// 媒体目录（站点根下 media/），供后台上传定位
  mediaFolderId BigInt  @map("media_folder_id")
  /// 1 启用 / 0 停用（停用即开放层全 404，R10）
  status       Int      @default(1) @map("status") @db.TinyInt
  /// 评论审核开关（1 开=需审核 / 0 关=直过审）
  commentAudit Int      @default(1) @map("comment_audit") @db.TinyInt
  /// SPA 回退入口（P7 D77/R78：template.json#spaFallback 读入，相对站点根；NULL = 无回退）
  spaFallback  String?  @map("spa_fallback") @db.VarChar(64)
  createTime   DateTime @default(now()) @map("create_time")
  updateTime   DateTime @updatedAt @map("update_time")

  /// 多站下按用户查列表（P4E R47/T59：原 user_id 唯一索引改普通索引）
  @@index([userId], map: "idx_site_user")
  @@map("site_site")
}

/// 站点数配额（P4E D51：照 cloud_usage 先例，首次建站/查配额时懒创建）
model SiteQuota {
  /// 懒创建（首次建站/查询配额时 upsert）
  userId     BigInt   @id @map("user_id")
  /// 站点数上限（count 语义，非字节），默认取配置 SITE_DEFAULT_LIMIT
  quota      Int      @map("quota")
  createTime DateTime @default(now()) @map("create_time")
  updateTime DateTime @updatedAt @map("update_time")

  @@map("site_quota")
}

/// 栏目树（≤3 级；P7 D73：内容池化后归用户所有，站点侧显隐由 site_column_display 控制）
model SiteColumn {
  id        BigInt   @id @default(autoincrement())
  /// 属主（P7 D73：内容归用户，不再挂 site_id）
  userId    BigInt   @map("user_id")
  /// 0 = 根；≤3 级（R6）
  parentId  BigInt   @default(0) @map("parent_id")
  name      String   @map("name") @db.VarChar(32)
  /// 同级排序，升序
  sort      Int      @default(0) @map("sort")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// 逻辑关联 site_article（relationMode=prisma，无物理 FK）
  articles SiteArticle[]
  /// 站点显隐（P7 D73：无行 = 该站不展示此栏目）
  displays  SiteColumnDisplay[]

  @@index([userId, parentId], map: "idx_column_user")
  @@map("site_column")
}

/// 标签（P7 D73：归用户所有；标签跟随文章，无按站显隐）
model SiteTag {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt   @map("user_id")
  name      String   @map("name") @db.VarChar(32)
  createdAt DateTime @default(now()) @map("created_at")

  /// 逻辑关联 site_article_tag（relationMode=prisma，无物理 FK）
  articleTags SiteArticleTag[]

  @@unique([userId, name], map: "uk_tag_user_name")
  @@map("site_tag")
}

/// 文章（P7 D73：内容池——归用户所有，发表到哪些站点由 site_article_publish 决定）
model SiteArticle {
  id          BigInt    @id @default(autoincrement())
  userId      BigInt    @map("user_id")
  /// 逻辑关联 site_column
  columnId    BigInt    @map("column_id")
  title       String    @map("title") @db.VarChar(100)
  /// 留空自动取正文纯文本前 100 字
  summary     String    @default("") @map("summary") @db.VarChar(200)
  /// 封面相对站点根路径（必须 media/ 前缀）
  coverPath   String?   @map("cover_path") @db.VarChar(255)
  /// markdown 原文（开放层下发原文，渲染由站点代码负责）
  contentMd   String    @map("content_md") @db.LongText
  /// 保存时统计（R14 口径）
  wordCount   Int       @default(0) @map("word_count")
  /// R8 去重计数
  viewCount   Int       @default(0) @map("view_count")
  /// 0 草稿 / 1 已发布
  status      Int       @default(0) @map("status") @db.TinyInt
  /// 首次发布时间（下架再上架不刷新）
  publishedAt DateTime? @map("published_at")
  /// 无 deleted_at（R7 物理删除）
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  column      SiteColumn            @relation(fields: [columnId], references: [id])
  articleTags SiteArticleTag[]
  comments    SiteComment[]
  publishes   SiteArticlePublish[]

  @@index([userId, status, publishedAt], map: "idx_article_user_status")
  @@index([userId, columnId], map: "idx_article_user_column")
  @@map("site_article")
}

/// 文章发表关联（P7 D73：内容池 —— 一篇文章可发表到多个站点，每站独立置顶）
model SiteArticlePublish {
  id          BigInt    @id @default(autoincrement())
  /// 逻辑关联 site_article
  articleId   BigInt    @map("article_id")
  /// 逻辑关联 site_site
  siteId      BigInt    @map("site_id")
  /// 该站置顶（每站独立，取代原 site_article.is_top）
  isTop       Int       @default(0) @map("is_top") @db.TinyInt
  /// 发表到该站的时间（沿用迁移前的 published_at）
  publishedAt DateTime? @map("published_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  /// 逻辑关联（relationMode=prisma，无物理 FK）
  article SiteArticle @relation(fields: [articleId], references: [id])

  @@unique([articleId, siteId], map: "uk_publish_article_site")
  @@index([siteId, isTop, publishedAt], map: "idx_publish_site")
  @@map("site_article_publish")
}

/// 栏目站点显隐（P7 D73：栏目在本体之外按站控制是否展示；无行 = 该站不展示）
model SiteColumnDisplay {
  id        BigInt   @id @default(autoincrement())
  /// 逻辑关联 site_column
  columnId  BigInt   @map("column_id")
  /// 逻辑关联 site_site
  siteId    BigInt   @map("site_id")
  /// 该站内排序，升序
  sort      Int      @default(0) @map("sort")
  createdAt DateTime @default(now()) @map("created_at")

  /// 逻辑关联（relationMode=prisma，无物理 FK）
  column SiteColumn @relation(fields: [columnId], references: [id])

  @@unique([columnId, siteId], map: "uk_display_column_site")
  @@index([siteId, sort], map: "idx_display_site")
  @@map("site_column_display")
}

/// 文章-标签
model SiteArticleTag {
  id        BigInt @id @default(autoincrement())
  articleId BigInt @map("article_id")
  tagId     BigInt @map("tag_id")

  article SiteArticle @relation(fields: [articleId], references: [id])
  tag     SiteTag     @relation(fields: [tagId], references: [id])

  @@unique([articleId, tagId])
  @@index([articleId])
  @@index([tagId])
  @@map("site_article_tag")
}

/// 评论
model SiteComment {
  id          BigInt   @id @default(autoincrement())
  /// 冗余
  siteId      BigInt   @map("site_id")
  articleId   BigInt   @map("article_id")
  /// 访客昵称
  nickname    String   @map("nickname") @db.VarChar(32)
  content     String   @map("content") @db.VarChar(500)
  /// 0 待审核 / 1 通过 / 2 驳回（审核开关关闭时提交直置 1）
  auditStatus Int      @default(0) @map("audit_status") @db.TinyInt
  /// 提交者 IP（R8 取值口径）
  ip          String   @map("ip") @db.VarChar(50)
  /// 作者回复内容（P6 D69：一级回复，每条评论至多一条；NULL = 无回复）
  replyContent String? @map("reply_content") @db.VarChar(500)
  /// 作者回复时间（与 replyContent 同生同灭）
  replyAt     DateTime? @map("reply_at")
  createdAt   DateTime @default(now()) @map("created_at")

  /// 逻辑关联 site_article（relationMode=prisma，无物理 FK）
  article SiteArticle @relation(fields: [articleId], references: [id])

  @@index([articleId, auditStatus], map: "idx_comment_article_audit")
  @@index([siteId, articleId, auditStatus], map: "idx_comment_site_article_audit")
  @@map("site_comment")
}

// ========== 应用平台域（P11，表名 app_ 前缀） ==========
// D87：用户表只是逻辑表，数据集中 app_record JSON 列；真实动态建表一票否决（击穿 Prisma 迁移/备份/沙箱）。
// 全部软删可回溯（app_def/app_table/app_page/app_record）；逻辑外键（relationMode=prisma，无物理 FK）。

/// 数据应用主档（D93：draft = AI 草稿不占 active 额度，限 3 个；active = 已入册）
model AppDef {
  id          BigInt    @id @default(autoincrement())
  /// 应用标识：用户内唯一（R93 slug 化名称 + 冲突 "(1)"）
  code        String    @map("code") @db.VarChar(64)
  /// 列保留不删（P14 D115 退役：停止签发与消费，历史值无害）
  pubCode     String    @unique @map("pub_code") @db.VarChar(12)
  name        String    @map("name") @db.VarChar(50)
  description String?   @map("description") @db.VarChar(200)
  /// draft / active
  status      String    @default("active") @map("status") @db.VarChar(10)
  /// 属主（逻辑关联 sys_user，禁 JOIN）
  ownerId     BigInt    @map("owner_id")
  /// 溯源应用（P13 复制用，机制预留，本期不写）
  sourceAppId BigInt?   @map("source_app_id")
  /// 版本号（机制预留，本期不实现历史回滚）
  version     Int       @default(1) @map("version")
  /// 可被授权读取的总开关（P14 D115 语义切换：授权命中后仍须为 1，否则 40400）
  isPublic    Int       @default(0) @map("is_public") @db.TinyInt
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([ownerId, code], map: "uk_app_owner_code")
  @@index([ownerId, status, deletedAt], map: "idx_app_owner_status")
  @@map("app_def")
}

/// 逻辑表（n:n 中间表也是一行，is_system=1 用户不可见、不计配额、不可删）
model AppTable {
  id        BigInt    @id @default(autoincrement())
  appId     BigInt    @map("app_id")
  /// 表标识（应用内唯一，slug）
  name      String    @map("name") @db.VarChar(64)
  label     String    @map("label") @db.VarChar(50)
  /// 1 = 系统生成（n:n 中间表）
  isSystem  Int       @default(0) @map("is_system") @db.TinyInt
  /// 表级暴露门禁（P12 R100；0 = 未暴露，字段开关受其约束）
  isExposed Int       @default(0) @map("is_exposed") @db.TinyInt
  /// 软删（D95）；软删时改名释放唯一槽（用户不可见）
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@unique([appId, name], map: "uk_table_app_name")
  @@index([appId, deletedAt], map: "idx_table_app")
  @@map("app_table")
}

/// 字段定义 = 沙箱校验规则本体（R88 七类；D95 软删保留历史数据）
model AppField {
  id          BigInt    @id @default(autoincrement())
  tableId     BigInt    @map("table_id")
  name        String    @map("name") @db.VarChar(64)
  label       String    @map("label") @db.VarChar(50)
  /// text / number / datetime / bool / enum / attachment / ref
  type        String    @map("type") @db.VarChar(20)
  required    Int       @default(0) @map("required") @db.TinyInt
  /// 默认值（JSON：字符串 / 数字 / 布尔）
  defaultVal  Json?     @map("default_val")
  /// enum 选项 [{ value, label }]（type=enum 必填）
  enumOptions Json?     @map("enum_options")
  /// ref 目标表（type=ref，1n 的 n 侧）
  refTableId  BigInt?   @map("ref_table_id")
  /// ref 是否多值（n:n 经 app_rel 中间表）
  refMultiple Int       @default(0) @map("ref_multiple") @db.TinyInt
  /// D95 软删（1 = 已删，数据保留）
  isDeleted   Int       @default(0) @map("is_deleted") @db.TinyInt
  /// 字段级暴露（P12 R100；默认 1，实际生效须表 is_exposed=1）
  isExposed   Int       @default(1) @map("is_exposed") @db.TinyInt
  sort        Int       @default(0) @map("sort")
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([tableId, name], map: "uk_field_table_name")
  @@index([tableId, isDeleted], map: "idx_field_table")
  @@map("app_field")
}

/// 关系（仅 n:n 显式登记；1n 由 app_field.ref_table_id 承载，R89）
model AppRel {
  id             BigInt    @id @default(autoincrement())
  appId          BigInt    @map("app_id")
  fromTableId    BigInt    @map("from_table_id")
  fromFieldId    BigInt    @map("from_field_id")
  toTableId      BigInt    @map("to_table_id")
  /// 本期仅 nm
  type           String    @default("nm") @map("type") @db.VarChar(10)
  /// 自动生成的中间表（app_table.is_system=1）
  throughTableId BigInt    @map("through_table_id")
  deletedAt      DateTime? @map("deleted_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@unique([appId, fromTableId, fromFieldId, toTableId], map: "uk_rel_app_from_to")
  @@map("app_rel")
}

/// 数据行（D87：用户数据唯一落点；row_id 为对外可见主键，uuid）
model AppRecord {
  id        BigInt    @id @default(autoincrement())
  appId     BigInt    @map("app_id")
  tableId   BigInt    @map("table_id")
  /// 对外可见主键（char(36) uuid）
  rowId     String    @unique @map("row_id") @db.Char(36)
  /// 字段名 → 值
  data      Json      @map("data")
  /// 热字段冗余生成列（每表 ≤5 个索引字段，R99）
  rC1       String?   @map("r_c1") @db.VarChar(191)
  rC2       String?   @map("r_c2") @db.VarChar(191)
  rC3       String?   @map("r_c3") @db.VarChar(191)
  rC4       String?   @map("r_c4") @db.VarChar(191)
  rC5       String?   @map("r_c5") @db.VarChar(191)
  createdBy BigInt?   @map("created_by")
  /// 软删
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@index([tableId, deletedAt], map: "idx_record_table")
  @@index([tableId, rC1], map: "idx_record_table_rc1")
  @@index([tableId, rC2], map: "idx_record_table_rc2")
  @@index([tableId, rC3], map: "idx_record_table_rc3")
  @@index([tableId, rC4], map: "idx_record_table_rc4")
  @@index([tableId, rC5], map: "idx_record_table_rc5")
  @@index([appId, updatedAt], map: "idx_record_app_updated")
  @@map("app_record")
}

/// 功能页（R90 / §5：schema 声明多数据源与动作；kind=admin 管理侧 / display 公开展示页见 P12 §28.4）
model AppPage {
  id            BigInt    @id @default(autoincrement())
  appId         BigInt    @map("app_id")
  /// admin（管理侧）/ display（P12 公开展示页）
  kind          String    @default("admin") @map("kind") @db.VarChar(20)
  /// display 页公开标记（P12 R102/R108；admin 页恒 0，不入动态菜单）
  isPublic      Int       @default(0) @map("is_public") @db.TinyInt
  /// 功能页标识（应用内唯一，路由段）
  code          String    @map("code") @db.VarChar(64)
  name          String    @map("name") @db.VarChar(50)
  /// 应用内相对路径（应用内唯一，重复 50007）
  route         String    @map("route") @db.VarChar(64)
  schema        Json      @map("schema")
  schemaVersion Int       @default(1) @map("schema_version")
  /// ai / manual
  genBy         String    @default("manual") @map("gen_by") @db.VarChar(10)
  sort          Int       @default(0) @map("sort")
  deletedAt     DateTime? @map("deleted_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@unique([appId, code], map: "uk_page_app_code")
  @@unique([appId, route], map: "uk_page_app_route")
  @@index([appId, kind, deletedAt], map: "idx_page_app_kind")
  @@map("app_page")
}

/// 附件引用索引（D96：cloud 删除预检的查询底座；写路径经 DataService 同步维护）
model AppAttachmentRef {
  id        BigInt    @id @default(autoincrement())
  appId     BigInt    @map("app_id")
  tableId   BigInt    @map("table_id")
  /// 逻辑关联 app_record
  recordId  BigInt    @map("record_id")
  fieldName String    @map("field_name") @db.VarChar(64)
  /// 逻辑关联 cloud_file
  fileId    BigInt    @map("file_id")
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([fileId, deletedAt], map: "idx_attref_file")
  @@index([appId, tableId, recordId], map: "idx_attref_record")
  @@map("app_attachment_ref")
}

// ==================== P13：应用市场（D107 快照式） ====================

/// 应用市场条目（D107：提交那一刻物化结构快照；审核与复制都只针对快照，源应用后续变更不影响在架版本）。
/// 状态机 pending → approved | rejected → delisted（D108）；「同应用 1 个活跃条目」为应用层校验（50013）。
model MarketListing {
  id            BigInt    @id @default(autoincrement())
  /// 市场条目编号（对外展示用；slug 化 + 4 位随机，全局唯一）
  code          String    @unique @map("code") @db.VarChar(64)
  /// 发布者（逻辑关联 sys_user，禁 JOIN）
  publisherId   BigInt    @map("publisher_id")
  /// 快照时冗余昵称（防用户改名影响在架卡片）
  publisherName String?   @map("publisher_name") @db.VarChar(50)
  /// 谱系：来源应用 id（副本的 app_def.source_app_id 同样记它，照 R93/ARCH §28.8）
  sourceAppId   BigInt    @map("source_app_id")
  /// 快照时冗余（与源应用解耦）
  name          String    @map("name") @db.VarChar(50)
  description   String?   @map("description") @db.VarChar(200)
  /// 结构快照（R117）：{ version, tables:[{name,label,fields:[…]}], rels:[…], pages:[…] }
  snapshot      Json      @map("snapshot")
  /// 演示数据（R118）：{ 表名: [ { 字段: 值 } ] }，attachment 字段值已置 null
  demoData      Json?     @map("demo_data")
  /// 1 = 含演示数据（列表卡片标记，免解析 JSON）
  hasDemo       Int       @default(0) @map("has_demo") @db.TinyInt
  /// pending / approved / rejected / delisted
  status        String    @default("pending") @map("status") @db.VarChar(10)
  /// 审核意见（拒绝必填，D108）
  reviewNote    String?   @map("review_note") @db.VarChar(500)
  /// 审核人（逻辑关联 sys_user）
  reviewerId    BigInt?   @map("reviewer_id")
  reviewedAt    DateTime? @map("reviewed_at")
  /// 上架时间（approve 时写入，浏览列表按它倒序）
  listedAt      DateTime? @map("listed_at")
  delistedAt    DateTime? @map("delisted_at")
  /// 复制次数（元数据卡片展示）
  copyCount     Int       @default(0) @map("copy_count")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([status, listedAt], map: "idx_market_status_listed")
  @@index([publisherId, sourceAppId, status], map: "idx_market_pub_app_status")
  @@map("market_listing")
}

// ==================== P14：展示应用与数据授权（D112/D114，表名 disp_ 前缀） ====================
// 模型修订期：展示应用独立实体（自有目录 + 站点挂靠可换）；授权两跳（数据应用 → 展示应用 → 挂靠站点）。
// 全部逻辑外键（relationMode=prisma，无物理 FK）；属主/站点均禁 JOIN。

/// 展示应用（D112）：AI 生成的静态 HTML/JS 展示页容器；自有目录，可挂靠站点（site_id NULL = 暂存区）
model DispDisplay {
  id         BigInt    @id @default(autoincrement())
  /// 属主（逻辑关联 sys_user，禁 JOIN）
  ownerId    BigInt    @map("owner_id")
  /// 展示应用名（属主内唯一，D112；软删改名释放唯一槽，同 app_table 口径）
  name       String    @map("name") @db.VarChar(64)
  /// 挂靠站点（逻辑关联 site_site，禁 JOIN；NULL = 暂存区未挂靠，D116）
  siteId     BigInt?   @map("site_id")
  /// 目录路径：挂靠 = 站点目录内相对路径；未挂靠 = 云盘暂存区路径（R127 移动语义）
  folderPath String    @map("folder_path") @db.VarChar(512)
  /// 1 正常 / 0 删除（软删；目录保留在云盘由用户处置，API §21.1）
  status     Int       @default(1) @map("status") @db.TinyInt
  deletedAt  DateTime? @map("deleted_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@unique([ownerId, name], map: "uk_disp_owner_name")
  @@index([ownerId, status, deletedAt], map: "idx_disp_owner_status")
  @@index([siteId, status, deletedAt], map: "idx_disp_site_status")
  @@map("disp_display")
}

/// 数据授权（D114）：数据应用 → 展示应用 的授权边；表/字段级沿用 P12 暴露三开关叠加（R125 次序）
model DispGrant {
  id        BigInt   @id @default(autoincrement())
  /// 数据应用（逻辑关联 app_def.id，禁 JOIN）
  appId     BigInt   @map("app_id")
  /// 展示应用（逻辑关联 disp_display.id，禁 JOIN）
  displayId BigInt   @map("display_id")
  /// 授予人（逻辑关联 sys_user，禁 JOIN）
  grantedBy BigInt   @map("granted_by")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([appId, displayId], map: "uk_grant_app_display")
  @@index([displayId], map: "idx_grant_display")
  @@map("disp_grant")
}
