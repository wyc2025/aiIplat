// iplat 数据库模型（第一期 system 域，表名全部 sys_ 前缀）
// 约定：model PascalCase + @@map，字段 camelCase + @map snake_case
// 说明：使用 relationMode="prisma"（逻辑外键），不生成物理外键约束——
//   sys_menu/sys_dept 自关联以 parent_id=0 表示根，物理 FK 无法满足；
//   软删除场景下物理 FK 会阻碍删除。关联完整性由 Service 层保证。
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "mysql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

// ========== 用户与权限 ==========

/// 用户
model SysUser {
  id          BigInt    @id @default(autoincrement())
  username    String    @unique @map("username") @db.VarChar(50)
  password    String    @map("password") @db.VarChar(100)
  nickname    String    @map("nickname") @db.VarChar(50)
  email       String?   @map("email") @db.VarChar(100)
  phone       String?   @map("phone") @db.VarChar(20)
  avatar      String?   @map("avatar") @db.VarChar(255)
  /// 0 未知 1 男 2 女
  gender      Int       @default(0) @map("gender") @db.TinyInt
  deptId      BigInt?   @map("dept_id")
  /// 1 启用 0 禁用
  status      Int       @default(1) @map("status") @db.TinyInt
  remark      String?   @map("remark") @db.VarChar(255)
  lastLoginAt DateTime? @map("last_login_at")
  lastLoginIp String?   @map("last_login_ip") @db.VarChar(50)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  dept      SysDept?      @relation(fields: [deptId], references: [id])
  userRoles SysUserRole[]
  usageLogs AiUsageLog[]
  toolCalls AiToolCall[]

  @@index([deptId])
  @@map("sys_user")
}

/// 角色
model SysRole {
  id        BigInt    @id @default(autoincrement())
  name      String    @map("name") @db.VarChar(50)
  /// 角色标识，如 admin、common
  code      String    @unique @map("code") @db.VarChar(50)
  sort      Int       @default(0) @map("sort")
  status    Int       @default(1) @map("status") @db.TinyInt
  remark    String?   @map("remark") @db.VarChar(255)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  userRoles SysUserRole[]
  roleMenus SysRoleMenu[]

  @@map("sys_role")
}

/// 用户-角色
model SysUserRole {
  id     BigInt @id @default(autoincrement())
  userId BigInt @map("user_id")
  roleId BigInt @map("role_id")

  user SysUser @relation(fields: [userId], references: [id])
  role SysRole @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId])
  @@index([roleId])
  @@map("sys_user_role")
}

/// 菜单（目录/菜单/按钮三级）
model SysMenu {
  id        BigInt   @id @default(autoincrement())
  /// 0 为根
  parentId  BigInt   @default(0) @map("parent_id")
  name      String   @map("name") @db.VarChar(50)
  /// 1 目录 2 菜单 3 按钮
  type      Int      @map("type") @db.TinyInt
  /// 路由地址（type 1/2）
  path      String?  @map("path") @db.VarChar(200)
  /// 前端组件路径，如 system/user/index（type 2）
  component String?  @map("component") @db.VarChar(200)
  /// 权限标识，如 system:user:create（type 3 必填）
  perms     String?  @map("perms") @db.VarChar(100)
  icon      String?  @map("icon") @db.VarChar(50)
  sort      Int      @default(0) @map("sort")
  /// 1 显示 0 隐藏
  visible   Int      @default(1) @map("visible") @db.TinyInt
  /// 1 启用 0 禁用
  status    Int      @default(1) @map("status") @db.TinyInt
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  roleMenus SysRoleMenu[]

  @@index([parentId])
  @@map("sys_menu")
}

/// 角色-菜单
model SysRoleMenu {
  id     BigInt @id @default(autoincrement())
  roleId BigInt @map("role_id")
  menuId BigInt @map("menu_id")

  role SysRole @relation(fields: [roleId], references: [id])
  menu SysMenu @relation(fields: [menuId], references: [id])

  @@unique([roleId, menuId])
  @@index([menuId])
  @@map("sys_role_menu")
}

// ========== 组织与字典 ==========

/// 部门
model SysDept {
  id        BigInt    @id @default(autoincrement())
  /// 0 为根
  parentId  BigInt    @default(0) @map("parent_id")
  name      String    @map("name") @db.VarChar(50)
  sort      Int       @default(0) @map("sort")
  status    Int       @default(1) @map("status") @db.TinyInt
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  users SysUser[]

  @@index([parentId])
  @@map("sys_dept")
}

/// 字典类型
model SysDictType {
  id        BigInt   @id @default(autoincrement())
  name      String   @map("name") @db.VarChar(50)
  /// 类型标识，如 sys_common_status
  type      String   @unique @map("type") @db.VarChar(100)
  status    Int      @default(1) @map("status") @db.TinyInt
  remark    String?  @map("remark") @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  dataList SysDictData[]

  @@map("sys_dict_type")
}

/// 字典数据
model SysDictData {
  id        BigInt   @id @default(autoincrement())
  typeId    BigInt   @map("type_id")
  label     String   @map("label") @db.VarChar(50)
  value     String   @map("value") @db.VarChar(50)
  sort      Int      @default(0) @map("sort")
  status    Int      @default(1) @map("status") @db.TinyInt
  remark    String?  @map("remark") @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  dictType SysDictType @relation(fields: [typeId], references: [id])

  @@index([typeId])
  @@map("sys_dict_data")
}

// ========== 日志与文件 ==========

/// 登录日志
model SysLoginLog {
  id        BigInt   @id @default(autoincrement())
  username  String   @map("username") @db.VarChar(50)
  ip        String?  @map("ip") @db.VarChar(50)
  browser   String?  @map("browser") @db.VarChar(100)
  os        String?  @map("os") @db.VarChar(100)
  /// 1 成功 0 失败
  status    Int      @map("status") @db.TinyInt
  message   String?  @map("message") @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([username])
  @@map("sys_login_log")
}

/// 操作日志
model SysOperationLog {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt?  @map("user_id")
  username  String?  @map("username") @db.VarChar(50)
  module    String?  @map("module") @db.VarChar(50)
  action    String?  @map("action") @db.VarChar(50)
  method    String?  @map("method") @db.VarChar(10)
  url       String?  @map("url") @db.VarChar(255)
  params    String?  @map("params") @db.Text
  ip        String?  @map("ip") @db.VarChar(50)
  status    Int?     @map("status") @db.TinyInt
  errorMsg  String?  @map("error_msg") @db.Text
  /// 耗时（毫秒）
  duration  Int?     @map("duration")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("sys_operation_log")
}

/// 文件记录
model SysFile {
  id           BigInt   @id @default(autoincrement())
  originalName String   @map("original_name") @db.VarChar(255)
  storageName  String   @map("storage_name") @db.VarChar(255)
  path         String   @map("path") @db.VarChar(255)
  url          String   @map("url") @db.VarChar(255)
  size         BigInt   @map("size")
  mimeType     String?  @map("mime_type") @db.VarChar(100)
  uploaderId   BigInt?  @map("uploader_id")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("sys_file")
}

// ========== AI 域（P2a） ==========

/// 大模型厂商
model AiProvider {
  id        BigInt   @id @default(autoincrement())
  name      String   @map("name") @db.VarChar(50)
  /// 厂商标识：deepseek / kimi / qwen / zhipu
  code      String   @unique @map("code") @db.VarChar(30)
  /// OpenAI 兼容端点
  baseUrl   String   @map("base_url") @db.VarChar(200)
  /// 接口返回一律掩码
  apiKey    String?  @map("api_key") @db.VarChar(255)
  /// 1 启用 0 禁用
  status    Int      @default(1) @map("status") @db.TinyInt
  sort      Int      @default(0) @map("sort")
  remark    String?  @map("remark") @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  models AiModel[]

  @@map("ai_provider")
}

/// 模型
model AiModel {
  id          BigInt   @id @default(autoincrement())
  providerId  BigInt   @map("provider_id")
  displayName String   @map("display_name") @db.VarChar(50)
  /// API 模型名，如 deepseek-chat
  model       String   @map("model") @db.VarChar(100)
  /// 输入单价（积分/千 tokens）
  inputPrice  Decimal  @map("input_price") @db.Decimal(8, 4)
  /// 输出单价（积分/千 tokens）
  outputPrice Decimal  @map("output_price") @db.Decimal(8, 4)
  /// 上下文长度（tokens），用于消息截取
  maxContext  Int      @map("max_context")
  /// 是否支持工具调用（P2b 用，本期存值）
  supportTool Int      @default(0) @map("support_tool") @db.TinyInt
  /// 1 启用 0 禁用
  status      Int      @default(1) @map("status") @db.TinyInt
  sort        Int      @default(0) @map("sort")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  provider AiProvider @relation(fields: [providerId], references: [id])

  conversations AiConversation[]
  messages      AiMessage[]
  usageLogs     AiUsageLog[]

  @@unique([providerId, model])
  @@index([providerId])
  @@map("ai_model")
}

/// 会话
model AiConversation {
  id        BigInt    @id @default(autoincrement())
  userId    BigInt    @map("user_id")
  /// 首条消息前 20 字自动生成，可改
  title     String    @map("title") @db.VarChar(100)
  /// 当前选用模型（切换模型即更新此字段）
  modelId   BigInt?   @map("model_id")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  messages AiMessage[]
  model    AiModel?    @relation(fields: [modelId], references: [id])
  usageLogs AiUsageLog[]
  toolCalls AiToolCall[]

  @@index([userId, updatedAt])
  @@index([modelId])
  @@map("ai_conversation")
}

/// 消息
model AiMessage {
  id             BigInt    @id @default(autoincrement())
  conversationId BigInt    @map("conversation_id")
  /// user / assistant（system 不持久化，由后端拼装）
  role           String    @map("role") @db.VarChar(20)
  content        String    @map("content") @db.LongText
  /// DeepSeek 思考模式的 reasoning_content（多轮工具调用回喂需原样回传）
  reasoningContent String? @map("reasoning_content") @db.LongText
  /// assistant 消息记录所用模型，可空
  modelId        BigInt?   @map("model_id")
  /// assistant 消息记录实际用量
  tokensInput    Int?      @map("tokens_input")
  tokensOutput   Int?      @map("tokens_output")
  /// 本条消息扣减积分（user 消息为 0）
  credits       Int       @default(0) @map("credits")
  /// 1 正常 2 失败（流中断/上游错误）
  status        Int       @default(1) @map("status") @db.TinyInt
  createdAt     DateTime  @default(now()) @map("created_at")
  deletedAt     DateTime? @map("deleted_at")

  conversation AiConversation @relation(fields: [conversationId], references: [id])
  model        AiModel?       @relation(fields: [modelId], references: [id])
  toolCalls    AiToolCall[]

  @@index([conversationId, createdAt])
  @@index([modelId])
  @@map("ai_message")
}

/// 套餐
model AiPlan {
  id             BigInt    @id @default(autoincrement())
  name           String    @map("name") @db.VarChar(50)
  code           String    @unique @map("code") @db.VarChar(50)
  /// 每月积分额度
  monthlyCredits BigInt    @map("monthly_credits")
  /// 展示用（本期无真实支付）
  price          Decimal   @map("price") @db.Decimal(10, 2)
  description    String?   @map("description") @db.VarChar(500)
  /// 1 启用 0 禁用
  status         Int       @default(1) @map("status") @db.TinyInt
  sort           Int       @default(0) @map("sort")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  userPlans AiUserPlan[]

  @@map("ai_plan")
}

/// 用户订阅（每用户一行生效记录）
model AiUserPlan {
  id           BigInt   @id @default(autoincrement())
  userId       BigInt   @unique @map("user_id")
  planId       BigInt   @map("plan_id")
  /// 当前计费周期（开通日起一个自然月）
  cycleStart   DateTime @map("cycle_start")
  cycleEnd     DateTime @map("cycle_end")
  /// 本周期总额度（快照，换套餐即更新）
  totalCredits BigInt   @map("total_credits")
  /// 本周期已用
  usedCredits  BigInt   @default(0) @map("used_credits")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  plan AiPlan @relation(fields: [planId], references: [id])

  @@index([planId])
  @@map("ai_user_plan")
}

/// 用量明细
model AiUsageLog {
  id             BigInt   @id @default(autoincrement())
  userId         BigInt   @map("user_id")
  conversationId BigInt   @map("conversation_id")
  /// message_id 用于结算幂等（unique）
  messageId      BigInt   @unique @map("message_id")
  modelId        BigInt   @map("model_id")
  tokensInput    Int      @map("tokens_input")
  tokensOutput   Int      @map("tokens_output")
  /// 1 = usage 为字符数估算（上游未返回），0 = 上游真实值
  estimated      Int      @default(0) @map("estimated") @db.TinyInt
  credits        Int      @map("credits")
  createdAt      DateTime @default(now()) @map("created_at")

  conversation AiConversation @relation(fields: [conversationId], references: [id])
  model        AiModel        @relation(fields: [modelId], references: [id])
  user         SysUser        @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([conversationId])
  @@index([modelId])
  @@map("ai_usage_log")
}

/// 工具调用留痕（P2b）
model AiToolCall {
  id             BigInt    @id @default(autoincrement())
  conversationId BigInt    @map("conversation_id")
  messageId      BigInt    @map("message_id")
  userId         BigInt    @map("user_id")
  toolName       String    @map("tool_name") @db.VarChar(50)
  /// 模型生成的调用参数
  params         Json      @map("params")
  /// read / write
  risk           String    @map("risk") @db.VarChar(10)
  /// pending / confirmed / rejected / executed / failed
  status         String    @map("status") @db.VarChar(20)
  /// 执行结果摘要（截断存储，最多 2000 字符）
  result         String?   @map("result") @db.Text
  errorMsg       String?   @map("error_msg") @db.VarChar(500)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  conversation AiConversation @relation(fields: [conversationId], references: [id])
  message      AiMessage      @relation(fields: [messageId], references: [id])
  user         SysUser        @relation(fields: [userId], references: [id])

  @@index([conversationId])
  @@index([userId, createdAt])
  @@map("ai_tool_call")
}

// ========== 云盘域（P3） ==========

/// 文件树（文件+文件夹统一建模）
model CloudFile {
  id          BigInt    @id @default(autoincrement())
  /// 属主（逻辑关联 sys_user，禁 JOIN）
  userId      BigInt    @map("user_id")
  /// 0 = 根目录
  parentId    BigInt    @default(0) @map("parent_id")
  /// 文件/文件夹名（不含路径）
  name        String    @map("name") @db.VarChar(64)
  /// 1 文件夹 / 0 文件
  isDir       Int       @map("is_dir") @db.TinyInt
  /// 字节；文件夹恒 0
  size        BigInt    @default(0) @map("size")
  mime        String?   @map("mime") @db.VarChar(100)
  /// 小写不带点，预览白名单判断用
  ext         String?   @map("ext") @db.VarChar(20)
  /// StorageService 相对路径（yyyyMM/uuid.ext）；文件夹为 null
  storageName String?   @map("storage_name") @db.VarChar(120)
  /// 0 未审核 / 1 通过 / 2 驳回 / 3 审核中（D13 预留）
  auditStatus Int       @default(0) @map("audit_status") @db.TinyInt
  /// 公开标记三态：0=继承父目录（新建默认）/ 1=显式公开 / 2=显式阻断（R2 修订：上溯遇第一个非继承节点定生死）
  isPublic    Int       @default(0) @map("is_public") @db.TinyInt
  /// 公开链接 token（P4c D30：挂 fileId，改名/移动不变；仅显式公开行有值，取消公开置空=轮换）
  publicToken String?   @map("public_token") @db.VarChar(32) @unique
  /// 公开文件夹允许访客浏览列表：1=允许 / 0=仅知道完整路径可访问（P4c D32，仅文件夹有意义）
  allowListing Int      @default(1) @map("allow_listing") @db.TinyInt
  /// 非空 = 在回收站（R2 只标记自身）
  deletedAt   DateTime? @map("deleted_at")
  createTime  DateTime  @default(now()) @map("create_time")
  updateTime  DateTime  @updatedAt @map("update_time")

  shares CloudShare[]

  @@index([userId, parentId, deletedAt])
  @@index([userId, deletedAt])
  @@map("cloud_file")
}

/// 公开链接
model CloudShare {
  id         BigInt    @id @default(autoincrement())
  /// 创建者
  userId     BigInt    @map("user_id")
  /// 逻辑关联 cloud_file（P4d D48 起可为文件夹行，is_dir=1）
  fileId     BigInt    @map("file_id")
  /// 随机 URL-safe 串（crypto.randomBytes）
  token        String  @unique @map("token") @db.VarChar(32)
  /// 提取码哈希（P4d D47/R42：bcrypt，不明文）；NULL = 无密码
  passwordHash String? @map("password_hash") @db.VarChar(64)
  /// 下载成功 +1
  visitCount Int       @default(0) @map("visit_count")
  /// null = 永久
  expireAt   DateTime? @map("expire_at")
  /// 1 有效 / 0 已停止（过期不置状态，靠 expire_at 判定）
  status     Int       @default(1) @map("status") @db.TinyInt
  createTime DateTime  @default(now()) @map("create_time")

  file CloudFile @relation(fields: [fileId], references: [id])

  @@index([fileId])
  @@index([userId])
  @@map("cloud_share")
}

/// 配额
model CloudUsage {
  /// 懒创建（首次上传/查询配额时）
  userId     BigInt   @id @map("user_id")
  /// 字节，默认 CLOUD_DEFAULT_QUOTA（1GB）
  quota      BigInt   @map("quota")
  /// 字节（R3 记账规则）
  used       BigInt   @default(0) @map("used")
  updateTime DateTime @updatedAt @map("update_time")

  @@map("cloud_usage")
}

// ========== 个人网站域（P4a，表名 site_ 前缀） ==========

/// 站点（P4E D51 起每用户可多站，站点数上限由 site_quota 控制）
model SiteSite {
  id           BigInt   @id @default(autoincrement())
  /// 属主（逻辑关联 sys_user，禁 JOIN）；多站（配额由 site_quota 控制）
  userId       BigInt   @map("user_id")
  /// 站点标识（R11：格式 + 保留字黑名单 + 全局唯一）
  slug         String   @unique @map("slug") @db.VarChar(32)
  /// 站点标题
  title        String   @map("title") @db.VarChar(50)
  description  String?  @map("description") @db.VarChar(200)
  /// 站点根目录（逻辑关联 cloud_file，经 CloudFacade 校验）
  rootFolderId BigInt   @map("root_folder_id")
  /// 媒体目录（站点根下 media/），供后台上传定位
  mediaFolderId BigInt  @map("media_folder_id")
  /// 1 启用 / 0 停用（停用即开放层全 404，R10）
  status       Int      @default(1) @map("status") @db.TinyInt
  /// 评论审核开关（1 开=需审核 / 0 关=直过审）
  commentAudit Int      @default(1) @map("comment_audit") @db.TinyInt
  /// SPA 回退入口（P7 D77/R78：template.json#spaFallback 读入，相对站点根；NULL = 无回退）
  spaFallback  String?  @map("spa_fallback") @db.VarChar(64)
  createTime   DateTime @default(now()) @map("create_time")
  updateTime   DateTime @updatedAt @map("update_time")

  /// 多站下按用户查列表（P4E R47/T59：原 user_id 唯一索引改普通索引）
  @@index([userId], map: "idx_site_user")
  @@map("site_site")
}

/// 站点数配额（P4E D51：照 cloud_usage 先例，首次建站/查配额时懒创建）
model SiteQuota {
  /// 懒创建（首次建站/查询配额时 upsert）
  userId     BigInt   @id @map("user_id")
  /// 站点数上限（count 语义，非字节），默认取配置 SITE_DEFAULT_LIMIT
  quota      Int      @map("quota")
  createTime DateTime @default(now()) @map("create_time")
  updateTime DateTime @updatedAt @map("update_time")

  @@map("site_quota")
}

/// 栏目树（≤3 级；P7 D73：内容池化后归用户所有，站点侧显隐由 site_column_display 控制）
model SiteColumn {
  id        BigInt   @id @default(autoincrement())
  /// 属主（P7 D73：内容归用户，不再挂 site_id）
  userId    BigInt   @map("user_id")
  /// 0 = 根；≤3 级（R6）
  parentId  BigInt   @default(0) @map("parent_id")
  name      String   @map("name") @db.VarChar(32)
  /// 同级排序，升序
  sort      Int      @default(0) @map("sort")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// 逻辑关联 site_article（relationMode=prisma，无物理 FK）
  articles SiteArticle[]
  /// 站点显隐（P7 D73：无行 = 该站不展示此栏目）
  displays  SiteColumnDisplay[]

  @@index([userId, parentId], map: "idx_column_user")
  @@map("site_column")
}

/// 标签（P7 D73：归用户所有；标签跟随文章，无按站显隐）
model SiteTag {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt   @map("user_id")
  name      String   @map("name") @db.VarChar(32)
  createdAt DateTime @default(now()) @map("created_at")

  /// 逻辑关联 site_article_tag（relationMode=prisma，无物理 FK）
  articleTags SiteArticleTag[]

  @@unique([userId, name], map: "uk_tag_user_name")
  @@map("site_tag")
}

/// 文章（P7 D73：内容池——归用户所有，发表到哪些站点由 site_article_publish 决定）
model SiteArticle {
  id          BigInt    @id @default(autoincrement())
  userId      BigInt    @map("user_id")
  /// 逻辑关联 site_column
  columnId    BigInt    @map("column_id")
  title       String    @map("title") @db.VarChar(100)
  /// 留空自动取正文纯文本前 100 字
  summary     String    @default("") @map("summary") @db.VarChar(200)
  /// 封面相对站点根路径（必须 media/ 前缀）
  coverPath   String?   @map("cover_path") @db.VarChar(255)
  /// markdown 原文（开放层下发原文，渲染由站点代码负责）
  contentMd   String    @map("content_md") @db.LongText
  /// 保存时统计（R14 口径）
  wordCount   Int       @default(0) @map("word_count")
  /// R8 去重计数
  viewCount   Int       @default(0) @map("view_count")
  /// 0 草稿 / 1 已发布
  status      Int       @default(0) @map("status") @db.TinyInt
  /// 首次发布时间（下架再上架不刷新）
  publishedAt DateTime? @map("published_at")
  /// 无 deleted_at（R7 物理删除）
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  column      SiteColumn            @relation(fields: [columnId], references: [id])
  articleTags SiteArticleTag[]
  comments    SiteComment[]
  publishes   SiteArticlePublish[]

  @@index([userId, status, publishedAt], map: "idx_article_user_status")
  @@index([userId, columnId], map: "idx_article_user_column")
  @@map("site_article")
}

/// 文章发表关联（P7 D73：内容池 —— 一篇文章可发表到多个站点，每站独立置顶）
model SiteArticlePublish {
  id          BigInt    @id @default(autoincrement())
  /// 逻辑关联 site_article
  articleId   BigInt    @map("article_id")
  /// 逻辑关联 site_site
  siteId      BigInt    @map("site_id")
  /// 该站置顶（每站独立，取代原 site_article.is_top）
  isTop       Int       @default(0) @map("is_top") @db.TinyInt
  /// 发表到该站的时间（沿用迁移前的 published_at）
  publishedAt DateTime? @map("published_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  /// 逻辑关联（relationMode=prisma，无物理 FK）
  article SiteArticle @relation(fields: [articleId], references: [id])

  @@unique([articleId, siteId], map: "uk_publish_article_site")
  @@index([siteId, isTop, publishedAt], map: "idx_publish_site")
  @@map("site_article_publish")
}

/// 栏目站点显隐（P7 D73：栏目在本体之外按站控制是否展示；无行 = 该站不展示）
model SiteColumnDisplay {
  id        BigInt   @id @default(autoincrement())
  /// 逻辑关联 site_column
  columnId  BigInt   @map("column_id")
  /// 逻辑关联 site_site
  siteId    BigInt   @map("site_id")
  /// 该站内排序，升序
  sort      Int      @default(0) @map("sort")
  createdAt DateTime @default(now()) @map("created_at")

  /// 逻辑关联（relationMode=prisma，无物理 FK）
  column SiteColumn @relation(fields: [columnId], references: [id])

  @@unique([columnId, siteId], map: "uk_display_column_site")
  @@index([siteId, sort], map: "idx_display_site")
  @@map("site_column_display")
}

/// 文章-标签
model SiteArticleTag {
  id        BigInt @id @default(autoincrement())
  articleId BigInt @map("article_id")
  tagId     BigInt @map("tag_id")

  article SiteArticle @relation(fields: [articleId], references: [id])
  tag     SiteTag     @relation(fields: [tagId], references: [id])

  @@unique([articleId, tagId])
  @@index([articleId])
  @@index([tagId])
  @@map("site_article_tag")
}

/// 评论
model SiteComment {
  id          BigInt   @id @default(autoincrement())
  /// 冗余
  siteId      BigInt   @map("site_id")
  articleId   BigInt   @map("article_id")
  /// 访客昵称
  nickname    String   @map("nickname") @db.VarChar(32)
  content     String   @map("content") @db.VarChar(500)
  /// 0 待审核 / 1 通过 / 2 驳回（审核开关关闭时提交直置 1）
  auditStatus Int      @default(0) @map("audit_status") @db.TinyInt
  /// 提交者 IP（R8 取值口径）
  ip          String   @map("ip") @db.VarChar(50)
  /// 作者回复内容（P6 D69：一级回复，每条评论至多一条；NULL = 无回复）
  replyContent String? @map("reply_content") @db.VarChar(500)
  /// 作者回复时间（与 replyContent 同生同灭）
  replyAt     DateTime? @map("reply_at")
  createdAt   DateTime @default(now()) @map("created_at")

  /// 逻辑关联 site_article（relationMode=prisma，无物理 FK）
  article SiteArticle @relation(fields: [articleId], references: [id])

  @@index([articleId, auditStatus], map: "idx_comment_article_audit")
  @@index([siteId, articleId, auditStatus], map: "idx_comment_site_article_audit")
  @@map("site_comment")
}
